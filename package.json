{
  "name": "helpflow-ai",
  "private": true,
  "version": "0.1.0",
  "description": "HelpFlow AI — multi-tenant AI customer support SaaS",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "eval:rag": "pnpm --filter @helpflow/evals run eval:rag",
    "db:generate": "pnpm --filter @helpflow/database run generate",
    "db:migrate": "pnpm --filter @helpflow/database run migrate",
    "db:migrate:deploy": "pnpm --filter @helpflow/database run migrate:deploy",
    "db:seed": "pnpm --filter @helpflow/database run seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
