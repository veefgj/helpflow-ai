# HelpFlow AI — environment variables. Validated at boot with a zod schema (packages/config).
# Copy to .env for local Docker Compose development.

# ── App URLs ──
# apps/web's dev/start scripts run on 3010, not Next's default 3000 — free up 3000 (or change both
# back) if nothing else on your machine needs it.
APP_URL=http://localhost:3010
API_URL=http://localhost:4000
WIDGET_ORIGIN=http://localhost:4100
NODE_ENV=development
PORT=4000
# Browser-visible copy for apps/web and apps/widget (Next.js only exposes NEXT_PUBLIC_* to the client).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database (ADR-004) ──
# Host port 5433, not 5432: keeps this project's Postgres container isolated from any other
# Postgres already running on this machine (see docker-compose.yml comment).
DATABASE_URL=postgresql://helpflow:helpflow@localhost:5433/helpflow?schema=public
DIRECT_DATABASE_URL=postgresql://helpflow:helpflow@localhost:5433/helpflow?schema=public

# ── Redis (BullMQ, rate limits, socket counts) ──
REDIS_URL=redis://localhost:6379

# ── Auth (ADR-005) ──
JWT_ACCESS_SECRET=change-me-dev-access-secret-min-32-chars
VISITOR_TOKEN_SECRET=change-me-dev-visitor-secret-min-32-chars
REFRESH_COOKIE_SECRET=change-me-dev-refresh-secret-min-32-chars

# ── AI provider (ADR-001) ──
# AI_PROVIDER=fake runs a deterministic in-process stub (no network, no key) — the same "stubbed
# LLM provider" the spec calls for in E2E tests (Section 10). Set AI_PROVIDER=openai and a real
# OPENAI_API_KEY to get real grounded answers and to run `pnpm eval:rag` for a real quality report.
AI_PROVIDER=fake
OPENAI_API_KEY=sk-replace-me
LLM_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Object storage (ADR-003) — MinIO locally, R2 in production ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=helpflow-documents
S3_ACCESS_KEY_ID=helpflow
S3_SECRET_ACCESS_KEY=helpflow-secret
S3_FORCE_PATH_STYLE=true

# ── Billing (Stripe Test Mode) ──
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_ID_PRO=price_replace-me

# ── Observability ──
SENTRY_DSN=
LOG_LEVEL=info
