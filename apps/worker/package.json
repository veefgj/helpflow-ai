{
  "name": "@helpflow/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "lint": "echo 'linted from repo root: pnpm run lint'",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@helpflow/ai": "workspace:*",
    "@helpflow/config": "workspace:*",
    "@helpflow/database": "workspace:*",
    "@helpflow/storage": "workspace:*",
    "@helpflow/types": "workspace:*",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.4",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
